{%- comment -%}
  Virtual Try-On Theme App Block (Lookfly Style Premium Widget UI)
{%- endcomment -%}

{%- assign vto_block_id = block.id -%}
{%- assign vto_variant = product.selected_or_first_available_variant -%}
{%- assign vto_variant_id = vto_variant.id -%}
{%- assign vto_product_title = product.title | escape -%}
{%- assign vto_garment_category = block.settings.garment_category | default: 'tops' -%}
{%- assign vto_garment_image = product.featured_image | image_url: width: 1024 | prepend: 'https:' -%}

<div
  class="vto-widget-root"
  id="vto-widget-{{ vto_block_id }}"
  data-vto-widget
  data-vto-block-id="{{ vto_block_id }}"
  data-vto-product-id="{{ product.id }}"
  data-vto-variant-id="{{ vto_variant_id }}"
  data-vto-garment-category="{{ vto_garment_category | escape }}"
  data-vto-garment-image-url="{% if product.featured_image %}{{ vto_garment_image }}{% endif %}"
  data-vto-product-title="{{ vto_product_title }}"
>
  <!-- Main In-Page Trigger Button -->
  <button
    type="button"
    class="vto-open-button"
    data-vto-open-button
    style="--vto-btn-bg: {{ block.settings.button_bg_color }}; --vto-btn-color: {{ block.settings.button_text_color }};"
  >
    <span class="vto-toggle-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zM12 4v16c4.41 0 8-3.59 8-8s-3.59-8-8-8z"/>
      </svg>
    </span>
    <span class="vto-open-button-label">{{ block.settings.button_label | escape }}</span>
  </button>
</div>

<!-- Floating Side Tab on Screen Right Edge -->
<button
  type="button"
  class="vto-side-floating-tab"
  data-vto-side-tab-id="{{ vto_block_id }}"
  aria-label="Open Virtual Try-On"
>
  <span class="vto-toggle-icon">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zM12 4v16c4.41 0 8-3.59 8-8s-3.59-8-8-8z"/>
    </svg>
  </span>
  <span class="vto-side-tab-text">VIRTUAL TRY-ON</span>
</button>

<!-- Virtual Try-On Floating Card Modal -->
<div
  id="vto-modal-{{ vto_block_id }}"
  class="vto-modal is-hidden"
  data-vto-modal
  data-vto-block-id="{{ vto_block_id }}"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
  <div class="vto-modal-backdrop" data-vto-modal-backdrop></div>

  <div class="vto-card-dialog">
    <!-- Header -->
    <header class="vto-card-header">
      <h3 class="vto-card-header-title">VIRTUAL TRY-ON</h3>
      <button
        type="button"
        class="vto-card-close-btn"
        data-vto-close-button
        aria-label="Close"
      >
        &times;
      </button>
    </header>

    <!-- STEP 1: Upload / Photo Selection -->
    <div class="vto-step vto-step-upload" data-vto-step="upload">
      <div class="vto-photo-preview-container" data-vto-photo-dropzone>
        <input
          type="file"
          class="vto-photo-file-input"
          data-vto-photo-file-input
          accept="image/png,image/jpeg,image/jpg,image/webp"
        />

        <!-- Empty Upload Prompt -->
        <div class="vto-upload-prompt" data-vto-photo-upload-prompt>
          <div class="vto-garment-thumb-header">
            <img src="{% if product.featured_image %}{{ product.featured_image | image_url: width: 300 }}{% endif %}" alt="{{ vto_product_title }}" />
          </div>
          <svg class="vto-upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <p class="vto-upload-main-text"><strong>Click to upload</strong> or drag photo</p>
          <span class="vto-upload-sub-text">Upload a full body or waist-up photo</span>
        </div>

        <!-- Photo Preview Box (shows selected photo) -->
        <div class="vto-photo-preview-box is-hidden" data-vto-customer-photo-preview>
          <img class="vto-customer-photo" data-vto-customer-photo-image src="" alt="Customer Photo" />
          <button type="button" class="vto-change-photo-pill" data-vto-change-photo-button>
            📷 Change Image
          </button>
        </div>
      </div>

      <div class="vto-error-message is-hidden" data-vto-error-message role="alert"></div>

      <!-- Action Button -->
      <div class="vto-card-footer">
        <button type="button" class="vto-primary-action-btn" data-vto-generate-button disabled>
          <span class="vto-toggle-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zM12 4v16c4.41 0 8-3.59 8-8s-3.59-8-8-8z"/>
            </svg>
          </span>
          Try it on virtually
        </button>
        <div class="vto-powered-by">Powered by <span>CleverCat</span></div>
      </div>
    </div>

    <!-- STEP 2: Preparing / Loading Screen -->
    <div class="vto-step vto-step-loading is-hidden" data-vto-step="loading">
      <h3 class="vto-loading-heading">Preparing your look...</h3>

      <!-- Side-by-side comparison box -->
      <div class="vto-comparison-box">
        <div class="vto-comparison-item">
          <img src="{% if product.featured_image %}{{ product.featured_image | image_url: width: 400 }}{% endif %}" alt="Garment" />
        </div>
        <div class="vto-comparison-divider">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </div>
        <div class="vto-comparison-item">
          <img class="vto-loading-user-img" data-vto-loading-user-image src="" alt="User" />
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="vto-progress-wrapper">
        <div class="vto-progress-bar">
          <div class="vto-progress-fill" data-vto-progress-fill style="width: 10%;"></div>
        </div>
        <div class="vto-progress-text" data-vto-progress-text>10%</div>
      </div>

      <p class="vto-disclaimer-text">
        Colors and fit shown in AI-generated previews may vary slightly from the final product.
      </p>

      <div class="vto-powered-by">Powered by <span>CleverCat</span></div>
    </div>

    <!-- STEP 3: Result Screen -->
    <div class="vto-step vto-step-result is-hidden" data-vto-step="result">
      <div class="vto-result-viewport">
        <img class="vto-result-image" data-vto-result-image alt="Virtual Try-On Result" />

        <!-- Overlay Control Icons (Top Right) -->
        <div class="vto-overlay-top-controls">
          <button type="button" class="vto-icon-btn vto-expand-btn" data-vto-expand-button title="Fullscreen preview">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 3 21 3 21 9"></polyline>
              <polyline points="9 21 3 21 3 15"></polyline>
              <line x1="21" y1="3" x2="14" y2="10"></line>
              <line x1="3" y1="21" x2="10" y2="14"></line>
            </svg>
          </button>
        </div>

        <!-- Original Garment Thumbnail Overlay (Bottom Left) -->
        <div class="vto-garment-thumb-overlay">
          <img src="{% if product.featured_image %}{{ product.featured_image | image_url: width: 200 }}{% endif %}" alt="Original Garment" />
        </div>

      <!-- Action Buttons -->
      <div class="vto-result-footer">
        <button type="button" class="vto-try-again-link" data-vto-retry-button>
          🔄 Try with another photo
        </button>
        <div class="vto-powered-by">Powered by <span>CleverCat</span></div>
      </div>
    </div>
  </div>
</div>
</div>

<!-- Fullscreen Lightbox Overlay for Result Image -->
<div class="vto-fullscreen-lightbox is-hidden" id="vto-lightbox-{{ vto_block_id }}" data-vto-lightbox data-vto-lightbox-id="{{ vto_block_id }}" aria-hidden="true">
  <button type="button" class="vto-lightbox-close-btn" data-vto-lightbox-close aria-label="Close fullscreen">&times;</button>
  <img class="vto-lightbox-image" data-vto-lightbox-image src="" alt="Fullscreen Try-On Result" />
</div>

{% schema %}
{
  "name": "Virtual Try-On Button",
  "target": "section",
  "stylesheet": "virtual-try-on.css",
  "javascript": "virtual-try-on.js",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Virtual Try On"
    },
    {
      "type": "select",
      "id": "garment_category",
      "label": "Garment category",
      "default": "tops",
      "options": [
        { "value": "tops", "label": "Tops / Tops & Kurtis" },
        { "value": "bottoms", "label": "Bottoms / Pants / Skirts" },
        { "value": "one-pieces", "label": "One-pieces / Dresses / Sarees" }
      ]
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#8B2323"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
